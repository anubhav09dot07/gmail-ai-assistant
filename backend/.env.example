# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-local-secret
TOKEN_FILE=backend/token.json

# Google Cloud OAuth 2.0 web application credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# Phase 3 chunking and local embeddings
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Phase 4 Qdrant vector storage
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gmail_knowledge
QDRANT_BATCH_SIZE=64

# Phase 5 query gates
GMAIL_EVIDENCE_THRESHOLD=0.62
GMAIL_RETRIEVAL_LIMIT=5
GMAIL_USER_ID=personal-gmail
GMAIL_SYNC_PAGE_SIZE=100
GMAIL_SYNC_MAX_MESSAGES=1000
SYNC_METADATA_FILE=backend/sync_metadata.json

# Phase 6 grounded generation (keep the key private)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30